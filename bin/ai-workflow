#!/usr/bin/env bash
# ==============================================================================
# ai-workflow — CLI Manager for Spec-Driven AI Development Workflows
# https://github.com/fededlV/spec-driven-ai-workflow
# ==============================================================================
# Enforces strict separation of concerns between Specification and Build agents,
# manages specification lifecycles, and automates multi-agent project onboarding.
# ==============================================================================

set -euo pipefail

# Resolve templates directory: check local repo path first, then installed config path
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_TEMPLATES_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/config/templates"
INSTALLED_TEMPLATES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ai-workflow/templates"

if [ -d "$REPO_TEMPLATES_DIR" ]; then
    TEMPLATES_DIR="$REPO_TEMPLATES_DIR"
elif [ -d "$INSTALLED_TEMPLATES_DIR" ]; then
    TEMPLATES_DIR="$INSTALLED_TEMPLATES_DIR"
else
    TEMPLATES_DIR=""
fi

# ANSI Colors
color_green="\033[0;32m"
color_blue="\033[0;34m"
color_yellow="\033[1;33m"
color_red="\033[0;31m"
color_bold="\033[1m"
color_reset="\033[0m"

log_info() {
    printf "${color_blue}ℹ${color_reset} %s\n" "$1"
}

log_success() {
    printf "${color_green}✓${color_reset} %s\n" "$1"
}

log_warn() {
    printf "${color_yellow}⚠${color_reset} %s\n" "$1"
}

log_error() {
    printf "${color_red}✗${color_reset} %s\n" "$1" >&2
}

cmd_help() {
    cat << 'EOF'
ai-workflow — Multi-Agent Spec-Driven Workflow Manager

USAGE:
    ai-workflow <command> [arguments] [options]

COMMANDS:
    init [path] [--force]    Initialize a repository with the Spec-Driven AI Workflow
    new-spec <change-slug>   Scaffold a new feature specification from template
    status [path]            Inspect active workflow mode, agent contracts, and specs status
    help                     Display this help message

WORKFLOW LIFECYCLE:
    1. ai-workflow init                  Scaffold project agent contracts & templates
    2. Edit AGENTS.md                    Define project test/lint/typecheck commands
    3. ai-workflow new-spec <feature>    Scaffold specs/<feature>/
    4. Specification Agent (Antigravity) Interview requirements, author spec.md & tasks.md
    5. Human Approval Gate               Set 'Status: Approved' in spec.md
    6. Build Agent (Claude Code)         Ground, challenge, and build via TDD (Red-Green-Refactor)

EOF
}

cmd_init() {
    local target_dir="."
    local force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-f)
                force=true
                shift
                ;;
            *)
                target_dir="$1"
                shift
                ;;
        esac
    done

    mkdir -p "$target_dir"
    target_dir="$(cd "$target_dir" && pwd)"

    if [ -z "$TEMPLATES_DIR" ] || [ ! -d "$TEMPLATES_DIR" ]; then
        log_error "Templates directory not found. Please run install.sh or verify templates path."
        exit 1
    fi

    printf "\n${color_bold}🚀 Initializing Spec-Driven AI Workflow in:${color_reset} %s\n\n" "$target_dir"

    # Core project-level contract files
    local files=("AGENTS.md" "CLAUDE.md" "GEMINI.md" "GLOSSARY.md")
    for f in "${files[@]}"; do
        local src="$TEMPLATES_DIR/$f"
        local dst="$target_dir/$f"
        if [ -f "$dst" ] && [ "$force" = false ]; then
            log_warn "File already exists, skipping: $f (use --force to overwrite)"
        else
            cp "$src" "$dst"
            log_success "Created: $f"
        fi
    done

    # Architecture Decision Records (ADR)
    mkdir -p "$target_dir/docs/adr"
    if [ ! -f "$target_dir/docs/adr/0000-template.md" ] || [ "$force" = true ]; then
        cp "$TEMPLATES_DIR/docs/adr/0000-template.md" "$target_dir/docs/adr/"
        log_success "Created: docs/adr/0000-template.md"
    fi

    # Specs scaffolding
    mkdir -p "$target_dir/specs/_template"
    for sf in spec.md tasks.md handoff.md; do
        if [ ! -f "$target_dir/specs/_template/$sf" ] || [ "$force" = true ]; then
            cp "$TEMPLATES_DIR/specs/_template/$sf" "$target_dir/specs/_template/"
        fi
    done
    log_success "Created: specs/_template/{spec.md,tasks.md,handoff.md}"

    printf "\n${color_green}${color_bold}Initialization complete!${color_reset}\n"
    printf "Next steps:\n"
    printf "  1. Open ${color_bold}AGENTS.md${color_reset} and fill in project verification commands.\n"
    printf "  2. Run ${color_bold}ai-workflow new-spec <change-slug>${color_reset} to scaffold a feature spec.\n"
    printf "  3. Launch Specification Agent (Antigravity) to interview and detail requirements.\n\n"
}

cmd_new_spec() {
    if [ $# -lt 1 ]; then
        log_error "Missing change slug. Usage: ai-workflow new-spec <change-slug>"
        exit 1
    fi

    local slug="$1"
    local spec_dir="specs/$slug"

    if [ -d "$spec_dir" ]; then
        log_error "Specification directory '$spec_dir' already exists."
        exit 1
    fi

    local template_source=""
    if [ -d "specs/_template" ]; then
        template_source="specs/_template"
    elif [ -n "$TEMPLATES_DIR" ] && [ -d "$TEMPLATES_DIR/specs/_template" ]; then
        template_source="$TEMPLATES_DIR/specs/_template"
    else
        log_error "No template directory found in specs/_template or $TEMPLATES_DIR/specs/_template"
        exit 1
    fi

    mkdir -p "$spec_dir"
    local today
    today="$(date +%Y-%m-%d)"

    for file in spec.md tasks.md handoff.md; do
        if [ -f "$template_source/$file" ]; then
            sed -e "s/<change-slug>/$slug/g" \
                -e "s/<change>/$slug/g" \
                -e "s/<date>/$today/g" \
                "$template_source/$file" > "$spec_dir/$file"
            log_success "Created: $spec_dir/$file"
        fi
    done

    printf "\n${color_green}${color_bold}Feature spec scaffolded at:${color_reset} %s/\n" "$spec_dir"
    printf "Next steps:\n"
    printf "  1. Launch ${color_bold}Antigravity${color_reset} to interview and detail the behavioral spec.\n"
    printf "  2. Review and give sign-off by setting ${color_bold}Status: Approved${color_reset} in $spec_dir/spec.md.\n"
    printf "  3. Launch ${color_bold}Claude Code${color_reset} to ground, challenge, and build the feature via TDD.\n\n"
}

cmd_status() {
    local target_dir="${1:-.}"
    target_dir="$(cd "$target_dir" && pwd)"

    printf "\n${color_bold}🔍 AI Workflow Status for:${color_reset} %s\n\n" "$target_dir"

    local is_spec_project=true
    for f in AGENTS.md CLAUDE.md GEMINI.md; do
        if [ -f "$target_dir/$f" ]; then
            printf "  ${color_green}✓${color_reset} %s present\n" "$f"
        else
            printf "  ${color_yellow}○${color_reset} %s missing\n" "$f"
            is_spec_project=false
        fi
    done

    if [ -d "$target_dir/specs" ]; then
        printf "  ${color_green}✓${color_reset} specs/ directory present\n"
    else
        printf "  ${color_yellow}○${color_reset} specs/ directory missing\n"
        is_spec_project=false
    fi

    printf "\n${color_bold}Workflow Mode:${color_reset} "
    if [ "$is_spec_project" = true ]; then
        printf "${color_green}SPEC-DRIVEN ARCHITECTURE ACTIVE${color_reset}\n"
        printf "  • Antigravity (Gemini): Specification & Architecture Agent (Docs Only)\n"
        printf "  • Claude Code: Spec-Driven Build Agent (Requires Status: Approved)\n"
    else
        printf "${color_blue}STANDARD / DEFAULT (Unconstrained)${color_reset}\n"
        printf "  • Both agents operate with full, default coding capabilities.\n"
    fi

    # Inspect active specifications
    if [ -d "$target_dir/specs" ]; then
        printf "\n${color_bold}Active Specifications:${color_reset}\n"
        local found_specs=0
        for spec_file in "$target_dir"/specs/*/spec.md; do
            if [ -f "$spec_file" ]; then
                found_specs=1
                local dir_name
                dir_name="$(basename "$(dirname "$spec_file")")"
                [ "$dir_name" = "_template" ] && continue

                local status
                status="$(grep -iE '\*\*Status:\*\*' "$spec_file" | head -n 1 | sed -E 's/.*Status:\*\* `?([^` <]+)`?.*/\1/' || echo "Unknown")"
                [ -z "$status" ] && status="Unknown"

                local approved_by
                approved_by="$(grep -iE '\*\*Approved By:\*\*' "$spec_file" | head -n 1 | sed -E 's/.*Approved By:\*\* `?([^`]+)`?.*/\1/' || echo "-")"
                [ -z "$approved_by" ] && approved_by="-"

                if [[ "$status" =~ [Aa]pproved ]]; then
                    printf "  • ${color_bold}%s${color_reset}: ${color_green}Approved${color_reset} (by %s) → ${color_green}Ready for Claude Code build${color_reset}\n" "$dir_name" "$approved_by"
                else
                    printf "  • ${color_bold}%s${color_reset}: ${color_yellow}%s${color_reset} → ${color_yellow}Waiting for specification / approval in Antigravity${color_reset}\n" "$dir_name" "$status"
                fi
            fi
        done
        if [ "$found_specs" -eq 0 ]; then
            printf "  (No specifications created yet. Run 'ai-workflow new-spec <name>' to create one.)\n"
        fi
    fi
    printf "\n"
}

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        init)
            cmd_init "$@"
            ;;
        new-spec)
            cmd_new_spec "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            log_error "Unknown command: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
